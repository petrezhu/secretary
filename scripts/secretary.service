[Unit]
Description=Secretary — Personal Digital Assistant Daemon
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/secretary
ExecStart=/usr/local/bin/secretary start
ExecStop=/usr/local/bin/secretary stop
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=secretary
MemoryMax=512M
CPUQuota=80%
PrivateTmp=false
EnvironmentFile=-/opt/secretary/.env

[Install]
WantedBy=multi-user.target
