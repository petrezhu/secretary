# Secretary — 环境变量配置
# 复制此文件为 .env 并填入你的实际值
# cp .env.example .env

# ── 用户信息 ─────────────────────────────────────────────
SECRETARY_USER_NAME=主人
SECRETARY_BOT_NAME=Secretary

# ── 数据路径 ─────────────────────────────────────────────
SECRETARY_DATA_DIR=/path/to/hermes/workspace/data
SECRETARY_HOME=/path/to/secretary
SECRETARY_LOGS_DIR=/path/to/hermes/workspace/logs
SECRETARY_OBSIDIAN_VAULT=/path/to/Obsidian-Vault
SECRETARY_PORTFOLIO_PATH=/path/to/portfolio.json

# ── SMTP 邮件通知 ────────────────────────────────────────
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_TO=your_email@example.com

# ── QQ Bot ───────────────────────────────────────────────
QQ_APP_ID=your_qq_app_id
QQ_CLIENT_SECRET=your_qq_client_secret

# ── LLM Harness ──────────────────────────────────────────
CLI_PROXY_URL=http://127.0.0.1:8317/v1
CLI_PROXY_API_KEY=your_api_key
